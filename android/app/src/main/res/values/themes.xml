<resources>
    <style name="Theme.LectureNotes" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#6B5CF6</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/card</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:windowBackground">@color/paper</item>
    </style>
    <color name="paper">#F6F5FB</color>
    <color name="card">#FFFFFF</color>
    <color name="soft">#F0EEFC</color>
    <color name="ink">#1D1B2E</color>
    <color name="ink2">#5D5B72</color>
    <color name="accent">#6B5CF6</color>
    <bool name="light_bars">true</bool>
</resources>
